# Use a long random value so browser sessions remain valid after server restarts.
STOCKGAME_STORAGE_SECRET=replace-with-a-long-random-value

# Optional: defaults to src/stockgame.db.
# STOCKGAME_DB_PATH=C:/path/to/stockgame.db

# Show manual price and market event tools. Restart the app after changing this.
DEBUG=false

# Optional JSON array or comma-separated list of ticker symbols.
# STOCKS=["MSFT", "AAPL", "NVDA"]

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
